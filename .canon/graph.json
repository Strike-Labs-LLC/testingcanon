          "SECURITY.md",
          "**/SECURITY.md",
          ".github/dependabot.yml",
          ".canon/**",
          ".sdlc/**",
          "release-please-config.json",
          ".release-please-manifest.json",
          ".releaserc*",
          "release.config.*",
          "infra/**",
          "terraform/**",
          "**/*.tf",
          "helm/**",
          "k8s/**",
          "Dockerfile",
          "**/.env*",
          "**/secrets/**",
          ".github/**"
        ],
        "granted": [
          "read_repository",
          "read_issues"
        ]
      },
      "producesCandidate": false,
      "attestsCandidate": false,
      "ownership": {
        "paths": [],
        "branches": [],
        "environments": []
