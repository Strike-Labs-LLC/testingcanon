{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh session-start",
        "powershell": "bash .github/hooks/scripts/audit-log.sh session-start",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh session-end",
        "powershell": "bash .github/hooks/scripts/audit-log.sh session-end",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh prompt",
        "powershell": "bash .github/hooks/scripts/audit-log.sh prompt",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh tool-use",
        "powershell": "bash .github/hooks/scripts/audit-log.sh tool-use",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh agent-stop",
        "powershell": "bash .github/hooks/scripts/audit-log.sh agent-stop",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh subagent-stop",
        "powershell": "bash .github/hooks/scripts/audit-log.sh subagent-stop",
        "timeoutSec": 30
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh error",
        "powershell": "bash .github/hooks/scripts/audit-log.sh error",
        "timeoutSec": 30
      }
    ]
  }
}
