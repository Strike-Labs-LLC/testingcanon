{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "(?:str_replace_editor|apply_patch|[A-Za-z_]*(?:[Ee]dit|[Ww]rite|[Cc]reate|[Pp]atch)[A-Za-z_]*)",
        "bash": "bash .github/hooks/scripts/deny-secret-writes.sh",
        "powershell": "bash .github/hooks/scripts/deny-secret-writes.sh",
        "env": {
          "CANON_SECRET_SCANNING": "required"
        },
        "timeoutSec": 30
      },
      {
        "type": "command",
        "matcher": "(?:[Bb]ash|[Pp]ower[Ss]hell|[A-Za-z_]*(?:[Ss]hell|[Tt]erminal|[Cc]ommand|[Ee]xecute)[A-Za-z_]*)",
        "bash": "bash .github/hooks/scripts/deny-destructive-data.sh",
        "powershell": "bash .github/hooks/scripts/deny-destructive-data.sh",
        "timeoutSec": 30
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh tool-failure",
        "powershell": "bash .github/hooks/scripts/audit-log.sh tool-failure",
        "timeoutSec": 30
      }
    ]
  }
}
